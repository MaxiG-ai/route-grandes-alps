# Hetzner Webhosting (Apache). Optional -- die Seite läuft auch ohne diese Datei.
# Nur Cache-Zeiten und Kompression, keine Umschreibungen.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Fotos und Leaflet ändern sich praktisch nie
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 month"
  # CSS/JS: eine Woche, damit ein Upload zeitnah ankommt
  ExpiresByType text/css                 "access plus 1 week"
  ExpiresByType application/javascript   "access plus 1 week"
  # HTML und JSON immer frisch prüfen -- ein Rebuild überschreibt
  # data/tracks/day-NN.json und data/overview.json unter derselben URL, mit
  # neuem Inhalt. Eine Woche Cache hieße: eine korrigierte Etappe zeigt bei
  # wiederkehrenden Besuchern bis zu eine Woche lang noch die alte Route.
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/json         "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
